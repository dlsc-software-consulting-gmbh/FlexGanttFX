<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.flexganttfx</groupId>
        <artifactId>gantt</artifactId>
        <version>12.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>demos</artifactId>
    <packaging>pom</packaging>
    <name>FlexGanttFXDemos</name>
    <description>Parent module for the FlexGanttFX demo applications.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <gpg.skip>true</gpg.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>
        <javafx.version>25</javafx.version>
    </properties>

    <!-- The demos use JPro and Gluon artifacts which are not available on Maven
         Central. These repositories are deliberately declared here and not in the
         root POM so that the published FlexGanttFX libraries do not force these
         repositories onto their consumers. -->
    <repositories>
        <repository>
            <id>jpro-sandec</id>
            <url>https://sandec.jfrog.io/artifactory/repo</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>jpro-sandec</id>
            <url>https://sandec.jfrog.io/artifactory/repo</url>
        </pluginRepository>
    </pluginRepositories>

    <modules>
        <module>FlexGanttFXAirport</module>
        <module>FlexGanttFXEditor</module>
        <module>FlexGanttFXEmirates</module>
        <module>FlexGanttFXFactory</module>
        <module>FlexGanttFXHospital</module>
        <module>FlexGanttFXMSProject</module>
        <module>FlexGanttFXSpaceMission</module>
        <module>FlexGanttFXSprint</module>
        <module>FlexGanttFXWeather</module>
        <module>FlexGanttFXF1</module>
        <module>FlexGanttFXEarthquake</module>
        <module>FlexGanttFXNaturalEvents</module>
    </modules>

    <build>
        <plugins>
            <!-- The demos are not part of the Maven Central release. -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
