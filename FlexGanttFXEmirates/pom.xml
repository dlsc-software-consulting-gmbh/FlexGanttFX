<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>emirates</artifactId>
	<name>FlexGanttFXEmirates</name>
	<description>Use case study for Emirates airlines</description>

	<parent>
		<groupId>com.flexganttfx</groupId>
		<artifactId>gantt</artifactId>
		<version>11.9.1</version>
		<relativePath>..</relativePath>
	</parent>

	<properties>
		<maven.javadoc.skip>true</maven.javadoc.skip>
	</properties>

	<pluginRepositories>

		<pluginRepository>
			<id>jpro - sandec repository</id>
			<url>http://sandec.bintray.com/repo</url>
		</pluginRepository>

	</pluginRepositories>

	<repositories>

		<repository>
			<id>my-local-emirates-repo</id>
			<url>file://${project.basedir}/repository</url>
		</repository>

		<repository>
			<id>jpro - sandec repository</id>
			<url>http://sandec.bintray.com/repo</url>
		</repository>

	</repositories>

	<dependencies>

		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-swing</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<dependency>
			<groupId>com.flexganttfx</groupId>
			<artifactId>extras</artifactId>
			<version>${project.parent.version}</version>
		</dependency>

		<dependency>
			<groupId>com.flexganttfx</groupId>
			<artifactId>experimental</artifactId>
			<version>${project.parent.version}</version>
		</dependency>

		<dependency>
			<groupId>com.opencsv</groupId>
			<artifactId>opencsv</artifactId>
			<version>4.6</version>
		</dependency>

		<dependency>
			<groupId>com.miglayout</groupId>
			<artifactId>miglayout-swing</artifactId>
			<version>5.2</version>
		</dependency>

		<dependency>
			<groupId>com.flexganttfx</groupId>
			<artifactId>mapviewer</artifactId>
			<version>1.0.0</version>
		</dependency>

		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
			<version>2.4.0-b180830.0359</version>
		</dependency>

		<dependency>
			<groupId>org.glassfish.jaxb</groupId>
			<artifactId>jaxb-runtime</artifactId>
			<version>2.4.0-b180830.0438</version>
		</dependency>

		<dependency>
			<groupId>javax.activation</groupId>
			<artifactId>javax.activation-api</artifactId>
			<version>1.2.0</version>
		</dependency>

	</dependencies>

	<build>
		<plugins>

			<plugin>
				<groupId>com.gluonhq</groupId>
				<artifactId>client-maven-plugin</artifactId>
				<version>0.0.1</version>
				<configuration>
					<mainClass>com.flexganttfx.emirates.EmiratesApp</mainClass>
					<graalLibsPath>/Users/lemmi/Downloads/bundle/lib</graalLibsPath>
				</configuration>
			</plugin>

			<plugin>
				<groupId>com.sandec.jpro</groupId>
				<artifactId>jpro-maven-plugin</artifactId>
				<version>${jpro.version}</version>
				<configuration>
					<visible>false</visible>
					<!-- noRenderJobs>true</noRenderJobs -->
					<mainClassName>com.flexganttfx.emirates.EmiratesApp</mainClassName>
					<openingPath>/</openingPath>
				</configuration>
			</plugin>

		</plugins>
	</build>

</project>