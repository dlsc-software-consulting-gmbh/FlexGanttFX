<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>showcase</artifactId>
	<packaging>jar</packaging>

	<name>FlexGanttFXShowcase</name>

	<parent>
		<groupId>com.flexganttfx</groupId>
		<artifactId>gantt</artifactId>
		<version>11.13.5</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<properties>
		<maven.deploy.skip>true</maven.deploy.skip>
		<maven.javadoc.skip>true</maven.javadoc.skip>
	</properties>

	<dependencies>

		<dependency>
			<groupId>fr.brouillard.oss</groupId>
			<artifactId>cssfx</artifactId>
			<version>${cssfx.version}</version>
		</dependency>

		<dependency>
			<groupId>io.github.mkpaz</groupId>
			<artifactId>devtoolsfx-connector</artifactId>
			<version>${devtoolsfx.version}</version>
		</dependency>

		<dependency>
			<groupId>io.github.mkpaz</groupId>
			<artifactId>devtoolsfx-gui</artifactId>
			<version>${devtoolsfx.version}</version>
		</dependency>

		<dependency>
			<groupId>com.flexganttfx</groupId>
			<artifactId>view</artifactId>
			<version>${project.parent.version}</version>
		</dependency>

		<dependency>
			<groupId>com.flexganttfx</groupId>
			<artifactId>msproject</artifactId>
			<version>${project.parent.version}</version>
		</dependency>

		<dependency>
			<groupId>com.flexganttfx</groupId>
			<artifactId>experimental</artifactId>
			<version>${project.parent.version}</version>
		</dependency>

		<dependency>
			<groupId>com.flexganttfx</groupId>
			<artifactId>extras</artifactId>
			<version>${project.parent.version}</version>
		</dependency>

		<dependency>
			<groupId>com.flexganttfx</groupId>
			<artifactId>emirates</artifactId>
			<version>${project.parent.version}</version>
		</dependency>

		<dependency>
			<groupId>com.flexganttfx</groupId>
			<artifactId>factory</artifactId>
			<version>${project.parent.version}</version>
		</dependency>

		<dependency>
			<groupId>com.flexganttfx</groupId>
			<artifactId>weather</artifactId>
			<version>${project.parent.version}</version>
		</dependency>

		<dependency>
			<groupId>com.flexganttfx</groupId>
			<artifactId>space-mission</artifactId>
			<version>${project.parent.version}</version>
		</dependency>

		<dependency>
			<groupId>com.flexganttfx</groupId>
			<artifactId>airport</artifactId>
			<version>${project.parent.version}</version>
		</dependency>

		<dependency>
			<groupId>com.flexganttfx</groupId>
			<artifactId>hospital</artifactId>
			<version>${project.parent.version}</version>
		</dependency>

		<dependency>
			<groupId>com.flexganttfx</groupId>
			<artifactId>sprint</artifactId>
			<version>${project.parent.version}</version>
		</dependency>

		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-web</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<dependency>
			<groupId>one.jpro.platform</groupId>
			<artifactId>jpro-mdfx</artifactId>
			<version>0.6.1</version>
		</dependency>

		<dependency>
			<groupId>one.jpro.platform</groupId>
			<artifactId>jpro-utils</artifactId>
			<version>${jpro-platform.version}</version>
		</dependency>

		<dependency>
			<groupId>com.opencsv</groupId>
			<artifactId>opencsv</artifactId>
			<version>4.6</version>
		</dependency>

		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
			<version>1.17.0</version>
		</dependency>

		<dependency>
			<groupId>org.kordamp.ikonli</groupId>
			<artifactId>ikonli-core</artifactId>
			<version>${ikonli.version}</version>
		</dependency>

		<dependency>
			<groupId>org.kordamp.ikonli</groupId>
			<artifactId>ikonli-materialdesign-pack</artifactId>
			<version>${ikonli.version}</version>
		</dependency>

		<dependency>
			<groupId>org.kordamp.ikonli</groupId>
			<artifactId>ikonli-javafx</artifactId>
			<version>${ikonli.version}</version>
		</dependency>

		<dependency>
			<groupId>io.github.mkpaz</groupId>
			<artifactId>atlantafx-base</artifactId>
			<version>${atlantafx.version}</version>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>one.jpro</groupId>
				<artifactId>jpro-maven-plugin</artifactId>
				<version>${jpro.version}</version>
				<configuration>
					<mainClassName>com.flexganttfx.demo.showcase.ShowcaseApp</mainClassName>
					<releaseName>jfxcentral</releaseName>
					<localJVMArgs>-Ddevelop=false</localJVMArgs>
					<port>8099</port>
					<releasePlatforms>
						<platform>linux</platform>
						<platform>current</platform>
					</releasePlatforms>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.gluonhq</groupId>
				<artifactId>client-maven-plugin</artifactId>
				<version>${client.maven.plugin.version}</version>
				<configuration>
					<mainClass>com.flexganttfx.demo.FlexGanttFXSampler</mainClass>
					<nativeImageArgs>
						<nativeImageArg>
							-H:IncludeResourceBundles=com.flexganttfx.view.util.messages,com.flexganttfx.extras.util.messages
						</nativeImageArg>
						<nativeImageArg>
							--no-fallback
						</nativeImageArg>
						<nativeImageArg>--allow-incomplete-classpath</nativeImageArg>
						<nativeImageArg>
							--trace-class-initialization=sun.instrument.InstrumentationImpl
						</nativeImageArg>
						<nativeImageArg>
							--initialize-at-build-time=sun.instrument.InstrumentationImpl
						</nativeImageArg>
					</nativeImageArgs>
					<reflectionList>
						<list>javafx.scene.control.TableColumnBase</list>
						<list>javax.xml.bind.JAXBContextFactory</list>
						<list>com.sun.xml.bind.v2.ContextFactory</list>
						<list>com.sun.xml.bind.v2.model.nav.ReflectionNavigator</list>
						<list>javax.xml.bind.annotation.XmlType</list>
					</reflectionList>
					<resourcesList>
						<list>.*\\.properties$</list>
						<list>.*\\.png$</list>
						<list>.*\\.jpg$</list>
						<list>.*\\.jpeg$</list>
						<list>.*\\.zip$</list>
					</resourcesList>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-maven-plugin</artifactId>
				<version>${javafx.maven.plugin.version}</version>
				<configuration>
					<mainClass>com.flexganttfx.demo.showcase.ShowcaseApp</mainClass>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.9.0</version>
				<executions>
					<execution>
						<id>copy-dependencies</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/libs
							</outputDirectory>
							<includeScope>compile</includeScope>
							<includeScope>runtime</includeScope>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>

				<configuration>
					<archive>
						<manifest>
							<useUniqueVersions>false</useUniqueVersions>
							<addClasspath>true</addClasspath>
							<classpathPrefix>libs/</classpathPrefix>
							<mainClass>
								com.flexganttfx.demo.showcase.ShowcaseApp
							</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>

		</plugins>
	</build>
</project>
